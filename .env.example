# Copy to .env and fill in as needed. NEVER commit a real .env.
# All values are optional unless you switch to an LLM generation backend.

# --- Generation backend (only needed if generation.backend == "openai") ------
# Works with any OpenAI-compatible endpoint (OpenAI, Together, Groq, Ollama...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional overrides (otherwise config.yaml values are used) ---------------
RAG_CONFIG=config.yaml
RAG_LOG_LEVEL=INFO

# --- HuggingFace (optional; only to silence telemetry / use a token) ---------
HF_HOME=
HUGGINGFACE_HUB_TOKEN=
